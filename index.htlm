<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1a1a2e">
<title>Nueva Vida v7</title>
<link rel="manifest" href="#" id="manifest-link">
<style>
  :root {
    --bg: #0f0f1a;
    --bg2: #1a1a2e;
    --bg3: #16213e;
    --card: #1e1e35;
    --accent: #e94560;
    --accent2: #0f3460;
    --text: #eaeaea;
    --text2: #aaaacc;
    --border: #2a2a4a;
    --green: #00d4aa;
    --yellow: #ffd166;
    --font-size: 17px;
    --radius: 16px;
    --nav-h: 64px;
    --header-h: 56px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, sans-serif; font-size: var(--font-size); }

  /* SCREENS */
  .screen { position: fixed; inset: 0; display: none; flex-direction: column; background: var(--bg); }
  .screen.active { display: flex; }

  /* HEADER */
  .header {
    height: var(--header-h); min-height: var(--header-h);
    display: flex; align-items: center; padding: 0 16px; gap: 10px;
    background: var(--bg2); border-bottom: 1px solid var(--border);
    position: relative; z-index: 10;
  }
  .header-title { font-size: 1.1em; font-weight: 700; flex: 1; }
  .btn-back {
    width: 48px; height: 48px; border-radius: 50%; border: none;
    background: var(--bg3); color: var(--text); font-size: 1.6em;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; flex-shrink: 0;
  }

  /* SCROLL CONTENT */
  .scroll-content {
    flex: 1; overflow-y: auto; overflow-x: hidden;
    padding: 12px; padding-bottom: calc(var(--nav-h) + 16px);
    -webkit-overflow-scrolling: touch;
  }

  /* BOTTOM NAV */
  .bottom-nav {
    height: var(--nav-h); min-height: var(--nav-h);
    display: flex; background: var(--bg2);
    border-top: 1px solid var(--border);
    position: relative; z-index: 20;
  }
  .nav-btn {
    flex: 1; border: none; background: transparent; color: var(--text2);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; cursor: pointer; font-size: 0.7em; transition: color 0.2s;
    padding: 6px 0;
  }
  .nav-btn .nav-icon { font-size: 1.6em; line-height: 1; }
  .nav-btn.active { color: var(--accent); }

  /* HOME SCREEN */
  #home .scroll-content { padding-top: 8px; }

  /* WEATHER BAR */
  .weather-bar {
    background: var(--card); border-radius: var(--radius);
    padding: 10px 14px; margin-bottom: 10px;
    display: flex; align-items: center; gap: 10px;
    border: 1px solid var(--border);
  }
  .weather-icon { font-size: 1.8em; }
  .weather-info { flex: 1; }
  .weather-temp { font-size: 1.1em; font-weight: 700; }
  .weather-desc { font-size: 0.78em; color: var(--text2); }
  .sun-alert {
    background: linear-gradient(135deg, #ff6b35, #f7c59f);
    color: #1a1a1a; border-radius: 10px; padding: 6px 10px;
    font-size: 0.75em; font-weight: 700; display: none;
  }
  .sun-alert.visible { display: block; }

  /* QUICK LINKS */
  .quick-links {
    display: flex; gap: 8px; margin-bottom: 12px; overflow-x: auto;
    scrollbar-width: none; padding-bottom: 2px;
  }
  .quick-links::-webkit-scrollbar { display: none; }
  .quick-btn {
    flex-shrink: 0; background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 8px 14px; color: var(--text);
    font-size: 0.82em; cursor: pointer; white-space: nowrap;
    display: flex; align-items: center; gap: 6px;
  }

  /* FOLDERS GRID */
  .section-title { font-size: 0.82em; color: var(--text2); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; padding-left: 2px; }
  .folders-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .folders-grid.cols3 { grid-template-columns: repeat(3, 1fr); }
  .folders-grid.list { grid-template-columns: 1fr; }

  .folder-card {
    background: var(--card); border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 14px 10px; text-align: center;
    cursor: pointer; user-select: none;
    transition: transform 0.1s, box-shadow 0.1s;
    position: relative; overflow: hidden;
    touch-action: pan-y; /* FIX #1 & #11: allow vertical scroll, only open on tap */
  }
  .folder-card:active { transform: scale(0.97); }
  .folder-card .folder-icon { font-size: 2em; line-height: 1; margin-bottom: 6px; }
  .folder-card .folder-name { font-size: 0.82em; font-weight: 600; color: var(--text); word-break: break-word; }
  .folder-card .folder-count { font-size: 0.7em; color: var(--text2); margin-top: 2px; }
  .folder-card .folder-accent { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; }

  /* FOLDER SCREEN */
  #folder-screen .scroll-content { padding-bottom: 80px; }
  .folder-header-color { width: 100%; height: 4px; }
  .entry-card {
    background: var(--card); border-radius: 12px; border: 1px solid var(--border);
    padding: 12px 14px; margin-bottom: 8px;
    display: flex; align-items: flex-start; gap: 10px;
  }
  .entry-text { flex: 1; font-size: 0.92em; line-height: 1.4; word-break: break-word; }
  .entry-date { font-size: 0.7em; color: var(--text2); margin-top: 4px; }
  .entry-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .entry-btn {
    width: 34px; height: 34px; border-radius: 8px; border: none;
    background: var(--bg3); color: var(--text2); cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 0.9em;
  }
  .empty-state { text-align: center; padding: 40px 20px; color: var(--text2); }
  .empty-icon { font-size: 3em; margin-bottom: 12px; }

  /* ADD ENTRY BAR */
  .add-bar {
    position: fixed; bottom: var(--nav-h); left: 0; right: 0;
    background: var(--bg2); border-top: 1px solid var(--border);
    padding: 10px 12px; display: flex; gap: 8px; align-items: center;
    z-index: 30;
  }
  .add-bar input {
    flex: 1; background: var(--bg3); border: 1px solid var(--border);
    border-radius: 10px; padding: 10px 12px; color: var(--text);
    font-size: 0.95em; outline: none;
  }
  .add-bar input::placeholder { color: var(--text2); }
  .add-bar .btn-save {
    background: var(--accent); color: white; border: none;
    border-radius: 10px; padding: 10px 16px; font-weight: 700;
    cursor: pointer; font-size: 0.9em; white-space: nowrap;
  }
  .add-bar .btn-mic-entry {
    width: 44px; height: 44px; border-radius: 10px; border: none;
    background: var(--bg3); color: var(--text); cursor: pointer;
    font-size: 1.3em; display: flex; align-items: center; justify-content: center;
  }

  /* REMINDER BUTTON IN ENTRY */
  .btn-reminder {
    background: var(--accent2); color: var(--green); border: none;
    border-radius: 8px; padding: 6px 10px; font-size: 0.78em;
    cursor: pointer; margin-top: 6px; display: inline-flex; align-items: center; gap: 4px;
  }

  /* RED FLOATING BUTTON - FIX #4: draggable */
  #fab {
    position: fixed; width: 62px; height: 62px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 4px 20px rgba(233,69,96,0.5);
    border: none; color: white; font-size: 1.6em; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 100; touch-action: none;
    transition: box-shadow 0.2s;
    bottom: calc(var(--nav-h) + 16px); right: 16px;
  }
  #fab.dragging { box-shadow: 0 8px 30px rgba(233,69,96,0.7); }
  #fab.listening { animation: pulse 1s infinite; background: #c0392b; }
  #fab.handsfree { background: #8e44ad; animation: pulse 0.7s infinite; }
  @keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.08)} }

  /* MIC MODAL - FIX #5 & #10 */
  #mic-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.85);
    display: none; align-items: center; justify-content: center;
    z-index: 200; flex-direction: column; gap: 20px;
  }
  #mic-modal.open { display: flex; }
  .mic-orb {
    width: 120px; height: 120px; border-radius: 50%;
    background: var(--accent); display: flex; align-items: center; justify-content: center;
    font-size: 3em; animation: mic-pulse 1.2s ease-in-out infinite;
    box-shadow: 0 0 0 0 rgba(233,69,96,0.4);
  }
  @keyframes mic-pulse {
    0% { box-shadow: 0 0 0 0 rgba(233,69,96,0.6); }
    70% { box-shadow: 0 0 0 30px rgba(233,69,96,0); }
    100% { box-shadow: 0 0 0 0 rgba(233,69,96,0); }
  }
  .mic-status { color: white; font-size: 1.1em; font-weight: 600; text-align: center; }
  .mic-transcript { color: var(--text2); font-size: 0.9em; max-width: 280px; text-align: center; min-height: 40px; }
  .mic-timer { color: var(--yellow); font-size: 1.4em; font-weight: 700; }
  .btn-mic-stop {
    background: rgba(255,255,255,0.15); color: white; border: 2px solid rgba(255,255,255,0.3);
    border-radius: 30px; padding: 12px 28px; font-size: 1em; cursor: pointer;
  }

  /* HANDSFREE BAR */
  #handsfree-bar {
    position: fixed; top: 0; left: 0; right: 0;
    background: #8e44ad; padding: 10px 16px;
    display: none; align-items: center; justify-content: space-between;
    z-index: 150; color: white; font-size: 0.85em; font-weight: 700;
  }
  #handsfree-bar.open { display: flex; }

  /* NV SCREEN */
  #nv-screen .scroll-content { display: flex; flex-direction: column; }
  .nv-chat { flex: 1; }
  .nv-msg { display: flex; gap: 10px; margin-bottom: 12px; }
  .nv-msg.user { flex-direction: row-reverse; }
  .nv-bubble {
    max-width: 80%; background: var(--card); border-radius: 16px;
    padding: 10px 14px; font-size: 0.9em; line-height: 1.5;
    border: 1px solid var(--border);
  }
  .nv-msg.user .nv-bubble { background: var(--accent2); border-color: transparent; }
  .nv-input-bar {
    position: fixed; bottom: var(--nav-h); left: 0; right: 0;
    background: var(--bg2); border-top: 1px solid var(--border);
    padding: 10px 12px; display: flex; gap: 8px;
    z-index: 30;
  }
  .nv-input {
    flex: 1; background: var(--bg3); border: 1px solid var(--border);
    border-radius: 24px; padding: 10px 16px; color: var(--text);
    font-size: 0.92em; outline: none;
  }
  .nv-send {
    width: 44px; height: 44px; border-radius: 50%; border: none;
    background: var(--accent); color: white; font-size: 1.2em; cursor: pointer;
  }
  .nv-mic {
    width: 44px; height: 44px; border-radius: 50%; border: none;
    background: var(--bg3); color: var(--text); font-size: 1.2em; cursor: pointer;
  }

  /* SEARCH */
  #search-screen .scroll-content { padding-top: 8px; }
  .search-bar {
    background: var(--card); border-radius: 12px; border: 1px solid var(--border);
    padding: 12px 14px; display: flex; gap: 10px; align-items: center;
    margin-bottom: 12px;
  }
  .search-bar input {
    flex: 1; background: transparent; border: none; color: var(--text);
    font-size: 1em; outline: none;
  }
  .search-bar input::placeholder { color: var(--text2); }

  /* CONFIG */
  .config-section { margin-bottom: 20px; }
  .config-section-title { font-size: 0.78em; color: var(--text2); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; padding: 0 2px; }
  .config-row {
    background: var(--card); border-radius: 12px; border: 1px solid var(--border);
    padding: 14px; margin-bottom: 6px; display: flex; align-items: center; gap: 12px;
  }
  .config-row-label { flex: 1; font-size: 0.95em; }
  .config-row-sub { font-size: 0.75em; color: var(--text2); margin-top: 2px; }
  .config-row button {
    background: var(--accent); color: white; border: none; border-radius: 8px;
    padding: 8px 14px; font-size: 0.85em; cursor: pointer;
  }

  /* SLIDER */
  .slider-row { flex-direction: column; align-items: stretch; gap: 10px; }
  .slider-labels { display: flex; justify-content: space-between; font-size: 0.8em; color: var(--text2); }
  input[type=range] {
    width: 100%; accent-color: var(--accent); height: 6px; cursor: pointer;
  }

  /* CONDUCTOR QUICK BUTTONS */
  .cq { background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; text-align: center; cursor: pointer; transition: all .15s; }
  .cq:active { transform: scale(.95); }
  .cq-icon { font-size: 1.8em; margin-bottom: 5px; }
  .cq-label { font-size: 0.82em; font-weight: 600; }
  #conductor-quick { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; width: 100%; max-width: 320px; }

  /* NV STATUS BAR */
  #nv-status {
    position: fixed; top: 0; left: 0; right: 0; z-index: 150;
    background: var(--accent2); color: var(--green);
    padding: 8px 16px; font-size: 0.82em; font-weight: 700;
    display: none; align-items: center; gap: 8px;
  }
  #nv-status.show { display: flex; }
  .theme-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .theme-pill {
    padding: 8px 14px; border-radius: 20px; border: 2px solid transparent;
    cursor: pointer; font-size: 0.82em; font-weight: 600;
  }
  .theme-pill.active { border-color: var(--accent); }

  /* LAYOUT PILLS */
  .layout-pills { display: flex; gap: 8px; }
  .layout-pill {
    flex: 1; padding: 8px; border-radius: 10px; border: 2px solid var(--border);
    cursor: pointer; font-size: 0.78em; text-align: center; background: var(--bg3);
    color: var(--text); transition: border-color 0.2s;
  }
  .layout-pill.active { border-color: var(--accent); color: var(--accent); }

  /* CONTACTS */
  .contact-item {
    background: var(--card); border-radius: 12px; border: 1px solid var(--border);
    padding: 12px 14px; margin-bottom: 6px; display: flex; align-items: center; gap: 10px;
  }
  .contact-avatar {
    width: 42px; height: 42px; border-radius: 50%; background: var(--accent2);
    display: flex; align-items: center; justify-content: center; font-size: 1.2em;
    flex-shrink: 0;
  }
  .contact-info { flex: 1; }
  .contact-name { font-weight: 600; }
  .contact-phone { font-size: 0.78em; color: var(--text2); }
  .contact-actions { display: flex; gap: 6px; }
  .contact-btn {
    width: 38px; height: 38px; border-radius: 10px; border: none;
    background: var(--bg3); color: var(--text); cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 1em;
  }
  .contact-btn.whatsapp { background: #075e54; color: #25d366; }
  .contact-btn.call { background: #0f3460; color: var(--green); }

  /* REMINDER MODAL */
  #reminder-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.85);
    display: none; align-items: flex-end; justify-content: center;
    z-index: 300;
  }
  #reminder-modal.open { display: flex; }
  .reminder-sheet {
    background: var(--bg2); border-radius: 20px 20px 0 0;
    padding: 20px 16px 36px; width: 100%; max-width: 500px;
    border-top: 2px solid var(--border);
  }
  .reminder-title { font-size: 1.1em; font-weight: 700; margin-bottom: 16px; }
  .reminder-sheet input, .reminder-sheet textarea {
    width: 100%; background: var(--bg3); border: 1px solid var(--border);
    border-radius: 10px; padding: 12px; color: var(--text); font-size: 0.95em;
    outline: none; margin-bottom: 10px;
  }
  .reminder-sheet textarea { min-height: 70px; resize: none; font-family: inherit; }
  .reminder-row { display: flex; gap: 8px; }
  .reminder-row input { flex: 1; }
  .reminder-btns { display: flex; gap: 10px; margin-top: 6px; }
  .btn-primary { flex: 1; background: var(--accent); color: white; border: none; border-radius: 10px; padding: 13px; font-size: 0.95em; font-weight: 700; cursor: pointer; }
  .btn-secondary { flex: 1; background: var(--bg3); color: var(--text); border: none; border-radius: 10px; padding: 13px; font-size: 0.95em; cursor: pointer; }

  /* NOTIFICATION PERMISSION BANNER */
  #notif-banner {
    background: linear-gradient(135deg, #0f3460, #16213e);
    border: 1px solid var(--green); border-radius: 12px;
    padding: 12px 14px; margin-bottom: 10px; display: none;
    align-items: center; gap: 10px;
  }
  #notif-banner.show { display: flex; }
  #notif-banner p { flex: 1; font-size: 0.82em; color: var(--text); }
  #notif-banner button { background: var(--green); color: #0f0f1a; border: none; border-radius: 8px; padding: 8px 12px; font-size: 0.82em; font-weight: 700; cursor: pointer; white-space: nowrap; }

  /* MODAL GENERIC */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.8);
    display: none; align-items: center; justify-content: center;
    z-index: 250; padding: 20px;
  }
  .modal-overlay.open { display: flex; }
  .modal-box {
    background: var(--bg2); border-radius: 16px; padding: 20px;
    width: 100%; max-width: 340px; border: 1px solid var(--border);
  }
  .modal-title { font-size: 1em; font-weight: 700; margin-bottom: 14px; }
  .modal-box input {
    width: 100%; background: var(--bg3); border: 1px solid var(--border);
    border-radius: 10px; padding: 11px 12px; color: var(--text);
    font-size: 0.95em; outline: none; margin-bottom: 10px;
  }
  .modal-btns { display: flex; gap: 8px; margin-top: 4px; }

  /* TOAST */
  #toast {
    position: fixed; bottom: calc(var(--nav-h) + 80px); left: 50%; transform: translateX(-50%);
    background: rgba(30,30,53,0.97); color: var(--text); border: 1px solid var(--border);
    border-radius: 12px; padding: 10px 18px; font-size: 0.88em;
    opacity: 0; transition: opacity 0.3s; z-index: 400; pointer-events: none;
    white-space: nowrap; max-width: 90vw; text-align: center;
  }
  #toast.show { opacity: 1; }

  /* DRIVER MODE */
  #driver-screen {
    background: #0a0a0a; justify-content: center; align-items: center;
  }
  .driver-mic {
    width: 160px; height: 160px; border-radius: 50%;
    background: var(--accent); border: none; color: white; font-size: 4em;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 0 60px rgba(233,69,96,0.4);
    margin-bottom: 24px;
  }
  .driver-status { color: var(--text2); font-size: 1.1em; text-align: center; }
  .driver-transcript { color: white; font-size: 1.3em; text-align: center; max-width: 300px; margin-top: 16px; min-height: 50px; }

  /* LANDSCAPE FIX #6 */
  @media (orientation: landscape) and (max-height: 500px) {
    :root { --header-h: 46px; --nav-h: 52px; --font-size: 15px; }
    .folders-grid { grid-template-columns: repeat(3, 1fr); }
    .folder-card { padding: 10px 8px; }
    .folder-card .folder-icon { font-size: 1.5em; }
    .scroll-content { padding: 8px; padding-bottom: calc(var(--nav-h) + 8px); }
    .weather-bar { padding: 8px 12px; }
    .driver-mic { width: 100px; height: 100px; font-size: 2.5em; }
  }

  /* COLORS */
  .t-dark { --bg:#0f0f1a;--bg2:#1a1a2e;--bg3:#16213e;--card:#1e1e35;--text:#eaeaea;--text2:#aaaacc;--border:#2a2a4a; }
  .t-light { --bg:#f0f2f5;--bg2:#ffffff;--bg3:#e8eaf0;--card:#ffffff;--text:#1a1a2e;--text2:#666688;--border:#d0d3e0; }
  .t-green { --bg:#0a1a0f;--bg2:#0f2a18;--bg3:#0d2012;--card:#122b1a;--text:#e0ffe8;--text2:#88ccaa;--border:#1a4028; }
  .t-sunset { --bg:#1a0f0a;--bg2:#2a1a0f;--bg3:#221508;--card:#2e1c0e;--text:#fff0e0;--text2:#cc9966;--border:#3a2510; }
  .t-purple { --bg:#120a1a;--bg2:#1e0f2e;--bg3:#160c22;--card:#231236;--text:#f0e0ff;--text2:#bb88cc;--border:#2e1840; }
  .t-navy { --bg:#080f1a;--bg2:#0f1e30;--bg3:#0c1828;--card:#122038;--text:#e0ecff;--text2:#7799bb;--border:#1a3050; }

  /* FOLDER COLORS */
  .fc-red{background:rgba(231,76,60,0.08);border-color:rgba(231,76,60,0.25);}
  .fc-blue{background:rgba(52,152,219,0.08);border-color:rgba(52,152,219,0.25);}
  .fc-green{background:rgba(39,174,96,0.08);border-color:rgba(39,174,96,0.25);}
  .fc-yellow{background:rgba(241,196,15,0.08);border-color:rgba(241,196,15,0.25);}
  .fc-purple{background:rgba(142,68,173,0.08);border-color:rgba(142,68,173,0.25);}
  .fc-orange{background:rgba(230,126,34,0.08);border-color:rgba(230,126,34,0.25);}
  .fc-cyan{background:rgba(26,188,156,0.08);border-color:rgba(26,188,156,0.25);}
  .fc-pink{background:rgba(255,107,157,0.08);border-color:rgba(255,107,157,0.25);}
  .fc-teal{background:rgba(0,150,136,0.08);border-color:rgba(0,150,136,0.25);}
  .fc-lime{background:rgba(139,195,74,0.08);border-color:rgba(139,195,74,0.25);}
  .fc-indigo{background:rgba(63,81,181,0.08);border-color:rgba(63,81,181,0.25);}
  .fc-brown{background:rgba(121,85,72,0.08);border-color:rgba(121,85,72,0.25);}

  .fa-red{background:#e74c3c;} .fa-blue{background:#3498db;} .fa-green{background:#27ae60;}
  .fa-yellow{background:#f1c40f;} .fa-purple{background:#8e44ad;} .fa-orange{background:#e67e22;}
  .fa-cyan{background:#1abc9c;} .fa-pink{background:#ff6b9d;} .fa-teal{background:#009688;}
  .fa-lime{background:#8bc34a;} .fa-indigo{background:#3f51b5;} .fa-brown{background:#795548;}
</style>
</head>
<body class="t-dark">

<!-- ===== TOAST ===== -->
<div id="toast"></div>

<!-- ===== HANDSFREE BAR ===== -->
<div id="handsfree-bar">
  <span>🎙️ MANOS LIBRES — Escuchando...</span>
  <button onclick="stopHandsfree()" style="background:rgba(255,255,255,0.2);border:none;color:white;border-radius:8px;padding:6px 12px;cursor:pointer;font-size:0.85em;">Desactivar</button>
</div>

<!-- ===== HOME SCREEN ===== -->
<div id="home" class="screen active">
  <div class="scroll-content">
    <div id="notif-banner" class="notif-banner">
      <p>🔔 Activá notificaciones para recibir recordatorios aunque la app esté cerrada</p>
      <button onclick="requestNotifPermission()">Activar</button>
    </div>
    <div class="weather-bar" id="weather-bar">
      <div class="weather-icon" id="weather-icon">🌤️</div>
      <div class="weather-info">
        <div class="weather-temp" id="weather-temp">Cargando...</div>
        <div class="weather-desc" id="weather-desc">Mar del Plata</div>
      </div>
      <div class="sun-alert" id="sun-alert">☀️ Protegete del sol</div>
    </div>
    <div class="quick-links">
      <button class="quick-btn" onclick="openMaps()">📍 Maps</button>
      <button class="quick-btn" onclick="openWA()">💬 WhatsApp</button>
      <button class="quick-btn" onclick="openYT('')">▶️ YouTube</button>
      <button class="quick-btn" onclick="activateConductorMode()">🚗 Conductor</button>
      <button class="quick-btn" onclick="toggleHandsfree()">🎙️ Manos libres</button>
    </div>
    <div class="section-title">Mis carpetas</div>
    <div class="folders-grid" id="folders-grid"></div>
  </div>
  <div class="bottom-nav">
    <button class="nav-btn active" onclick="showScreen('home',this)"><span class="nav-icon">🏠</span>Inicio</button>
    <button class="nav-btn" onclick="showScreen('nv-screen',this)"><span class="nav-icon">🤖</span>NV</button>
    <button class="nav-btn" onclick="showScreen('search-screen',this)"><span class="nav-icon">🔍</span>Buscar</button>
    <button class="nav-btn" onclick="showScreen('config-screen',this)"><span class="nav-icon">⚙️</span>Config</button>
  </div>
</div>

<!-- ===== FOLDER SCREEN ===== -->
<div id="folder-screen" class="screen">
  <div class="header">
    <button class="btn-back" onclick="closeFolder()">←</button>
    <div class="header-title" id="folder-title">Carpeta</div>
    <button onclick="openReminderModal()" style="background:none;border:none;color:var(--text2);font-size:1.4em;cursor:pointer;padding:8px;">⏰</button>
  </div>
  <div class="folder-header-color" id="folder-header-color"></div>
  <div class="scroll-content" id="folder-entries"></div>
  <div class="add-bar">
    <button class="btn-mic-entry" id="btn-mic-entry" onclick="micForEntry()">🎙️</button>
    <input type="text" id="entry-input" placeholder="Escribí o hablá..." />
    <button class="btn-save" onclick="saveEntry()">GUARDAR</button>
  </div>
  <div class="bottom-nav">
    <button class="nav-btn" onclick="showScreen('home',null);closeFolder()"><span class="nav-icon">🏠</span>Inicio</button>
    <button class="nav-btn" onclick="showScreen('nv-screen',null)"><span class="nav-icon">🤖</span>NV</button>
    <button class="nav-btn" onclick="showScreen('search-screen',null)"><span class="nav-icon">🔍</span>Buscar</button>
    <button class="nav-btn" onclick="showScreen('config-screen',null)"><span class="nav-icon">⚙️</span>Config</button>
  </div>
</div>

<!-- ===== NV AI SCREEN ===== -->
<div id="nv-screen" class="screen">
  <div class="header">
    <div style="font-size:1.4em;">🤖</div>
    <div class="header-title">NV — Asistente</div>
  </div>
  <div class="scroll-content">
    <div class="nv-chat" id="nv-chat">
      <div class="nv-msg">
        <div class="nv-bubble">¡Hola! Soy NV, tu asistente personal. Podés preguntarme cualquier cosa, pedirme que guarde notas, busque información o te ayude a organizar tu día. ¿En qué te ayudo?</div>
      </div>
    </div>
  </div>
  <div class="nv-input-bar">
    <button class="nv-mic" onclick="micForNV()">🎙️</button>
    <input class="nv-input" id="nv-input" placeholder="Preguntá o dictá..." onkeydown="if(event.key==='Enter')sendNV()"/>
    <button class="nv-send" onclick="sendNV()">➤</button>
  </div>
  <div class="bottom-nav">
    <button class="nav-btn" onclick="showScreen('home',null)"><span class="nav-icon">🏠</span>Inicio</button>
    <button class="nav-btn active"><span class="nav-icon">🤖</span>NV</button>
    <button class="nav-btn" onclick="showScreen('search-screen',null)"><span class="nav-icon">🔍</span>Buscar</button>
    <button class="nav-btn" onclick="showScreen('config-screen',null)"><span class="nav-icon">⚙️</span>Config</button>
  </div>
</div>

<!-- ===== SEARCH SCREEN ===== -->
<div id="search-screen" class="screen">
  <div class="header">
    <div class="header-title">🔍 Buscar</div>
  </div>
  <div class="scroll-content">
    <div class="search-bar">
      <input type="text" id="search-input" placeholder="Buscar en todas las carpetas..." oninput="doSearch(this.value)" />
      <span style="font-size:1.3em;color:var(--text2)">🔍</span>
    </div>
    <div id="search-results"></div>
  </div>
  <div class="bottom-nav">
    <button class="nav-btn" onclick="showScreen('home',null)"><span class="nav-icon">🏠</span>Inicio</button>
