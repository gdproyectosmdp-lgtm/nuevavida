      <div onclick="selectColor('blue',this)" style="width:30px;height:30px;border-radius:50%;background:#3498db;cursor:pointer;border:2px solid transparent;"></div>
      <div onclick="selectColor('green',this)" style="width:30px;height:30px;border-radius:50%;background:#27ae60;cursor:pointer;border:2px solid transparent;"></div>
      <div onclick="selectColor('yellow',this)" style="width:30px;height:30px;border-radius:50%;background:#f1c40f;cursor:pointer;border:2px solid transparent;"></div>
      <div onclick="selectColor('purple',this)" style="width:30px;height:30px;border-radius:50%;background:#8e44ad;cursor:pointer;border:2px solid transparent;"></div>
      <div onclick="selectColor('orange',this)" style="width:30px;height:30px;border-radius:50%;background:#e67e22;cursor:pointer;border:2px solid transparent;"></div>
      <div onclick="selectColor('cyan',this)" style="width:30px;height:30px;border-radius:50%;background:#1abc9c;cursor:pointer;border:2px solid transparent;"></div>
