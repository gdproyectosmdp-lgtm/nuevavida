  </div>
</div>

<!-- ===== CONFIG SCREEN ===== -->
<div id="config-screen" class="screen">
  <div class="header">
    <div class="header-title">⚙️ Configuración</div>
  </div>
  <div class="scroll-content">

    <div class="config-section">
      <div class="config-section-title">Apariencia</div>
      <div class="config-row">
        <div>
          <div class="config-row-label">Tema de color</div>
          <div style="margin-top:10px;" class="theme-pills" id="theme-pills">
            <div class="theme-pill active" style="background:#1a1a2e;color:#eaeaea" onclick="setTheme('dark',this)">Oscuro</div>
            <div class="theme-pill" style="background:#f0f2f5;color:#1a1a2e" onclick="setTheme('light',this)">Claro</div>
            <div class="theme-pill" style="background:#0f2a18;color:#e0ffe8" onclick="setTheme('green',this)">Verde</div>
            <div class="theme-pill" style="background:#2a1a0f;color:#fff0e0" onclick="setTheme('sunset',this)">Atardecer</div>
            <div class="theme-pill" style="background:#1e0f2e;color:#f0e0ff" onclick="setTheme('purple',this)">Morado</div>
            <div class="theme-pill" style="background:#0f1e30;color:#e0ecff" onclick="setTheme('navy',this)">Navy</div>
          </div>
        </div>
      </div>
      <div class="config-row slider-row">
        <div class="config-row-label">Tamaño de texto</div>
        <div class="slider-labels"><span>AA</span><span id="font-label">17px</span></div>
        <!-- FIX #7: default 17px (larger) -->
        <input type="range" id="font-slider" min="13" max="24" value="17" oninput="setFontSize(this.value)">
      </div>
      <div class="config-row">
        <div>
          <div class="config-row-label">Layout de carpetas</div>
          <div style="margin-top:10px;" class="layout-pills">
            <div class="layout-pill active" onclick="setLayout('2',this)">2 col</div>
            <div class="layout-pill" onclick="setLayout('3',this)">3 col</div>
            <div class="layout-pill" onclick="setLayout('list',this)">Lista</div>
          </div>
        </div>
      </div>
    </div>

    <div class="config-section">
      <div class="config-section-title">Carpetas</div>
      <div id="folder-config-list"></div>
      <button onclick="openAddFolderModal()" style="width:100%;background:var(--card);border:1px dashed var(--border);border-radius:12px;padding:14px;color:var(--text2);cursor:pointer;font-size:0.9em;margin-top:6px;">+ Agregar carpeta</button>
    </div>

    <div class="config-section">
      <div class="config-section-title">Contactos frecuentes</div>
      <div id="contacts-list"></div>
      <button onclick="openAddContactModal()" style="width:100%;background:var(--card);border:1px dashed var(--border);border-radius:12px;padding:14px;color:var(--text2);cursor:pointer;font-size:0.9em;margin-top:6px;">+ Agregar contacto</button>
    </div>

    <div class="config-section">
