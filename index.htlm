        <button onclick="document.getElementById('import-file').click()">Importar</button>
        <input type="file" id="import-file" accept=".json" style="display:none" onchange="importBackup(this)">
      </div>
      <div class="config-row">
        <div class="config-row-label">Backup por WhatsApp<div class="config-row-sub">Te mandás el resumen</div></div>
        <button onclick="backupWhatsApp()">Enviar</button>
      </div>
      <div class="config-row">
        <div class="config-row-label">Borrar todo<div class="config-row-sub">Elimina todos los datos</div></div>
        <button onclick="clearAll()" style="background:#e74c3c;">Borrar</button>
      </div>
    </div>

    <div class="config-section">
      <div class="config-section-title">Acerca de</div>
      <div class="config-row">
        <div class="config-row-label">Nueva Vida v7.0<div class="config-row-sub">NV Core Pro · Tu herramienta personal</div></div>
      </div>
    </div>
  </div>
  <div class="bottom-nav">
    <button class="nav-btn" onclick="showScreen('home',null)"><span class="nav-icon">🏠</span>Inicio</button>
    <button class="nav-btn" onclick="showScreen('nv-screen',null)"><span class="nav-icon">🤖</span>NV</button>
    <button class="nav-btn" onclick="showScreen('search-screen',null)"><span class="nav-icon">🔍</span>Buscar</button>
    <button class="nav-btn active"><span class="nav-icon">⚙️</span>Config</button>
  </div>
</div>

