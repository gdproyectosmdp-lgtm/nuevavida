<!-- ===== RED FAB (FIX #4: draggable) ===== -->
<button id="fab" title="Micrófono">🎙️</button>

<script>
// ============================================================
// DATA
// ============================================================
const DEFAULT_FOLDERS = [
  {id:'f1',icon:'🏠',name:'Obra/Casa',color:'red',entries:[]},
  {id:'f2',icon:'🚗',name:'Autos',color:'blue',entries:[]},
  {id:'f3',icon:'🛋️',name:'Hogar',color:'orange',entries:[]},
  {id:'f4',icon:'💰',name:'Mi Economía',color:'green',entries:[],
   sub:[{id:'f4a',icon:'📈',name:'Ingresos',color:'green',entries:[]},
        {id:'f4b',icon:'📉',name:'Egresos',color:'red',entries:[]},
        {id:'f4c',icon:'🤝',name:'Préstamos',color:'yellow',entries:[]},
        {id:'f4d',icon:'💸',name:'Lo que me deben',color:'cyan',entries:[]}]},
  {id:'f5',icon:'🏥',name:'Salud',color:'pink',entries:[]},
  {id:'f6',icon:'💡',name:'Proyectos e inventos',color:'purple',entries:[]},
  {id:'f7',icon:'🎵',name:'Música/DJ',color:'indigo',entries:[]},
  {id:'f8',icon:'🔮',name:'Espiritualidad',color:'purple',entries:[
    {text:'Vi el número 44 dos veces en dos teléfonos distintos al mismo tiempo.',date:new Date().toISOString()}
  ]},
  {id:'f9',icon:'🔧',name:'Herramientas',color:'brown',entries:[],
   sub:[{id:'f9a',icon:'🔨',name:'Mis herramientas',color:'brown',entries:[]},
        {id:'f9b',icon:'📥',name:'Prestadas a mí',color:'orange',entries:[]},
        {id:'f9c',icon:'📤',name:'Que presté yo',color:'yellow',entries:[]}]},
  {id:'f10',icon:'🛒',name:'Compras',color:'lime',entries:[]},
  {id:'f11',icon:'💭',name:'Sueños',color:'teal',entries:[]},
  {id:'f12',icon:'✨',name:'Señales & Sincronías',color:'purple',entries:[]},
  {id:'f13',icon:'📥',name:'Para ordenar',color:'brown',entries:[]},
  {id:'f14',icon:'🎬',name:'Multimedia / Links',color:'pink',entries:[]}
];

let state = {
  folders: [],
  contacts: [],
  reminders: [],
  theme: 'dark',
  fontSize: 17,
  layout: '2',
  currentFolder: null
};

function loadState() {
  const saved = localStorage.getItem('nv7_state');
  if (saved) {
    try {
      const s = JSON.parse(saved);
      state = { ...state, ...s };
      if (!state.folders || state.folders.length === 0) state.folders = DEFAULT_FOLDERS;
    } catch(e) { state.folders = DEFAULT_FOLDERS; }
  } else {
    state.folders = DEFAULT_FOLDERS;
  }
}

function saveState() {
  localStorage.setItem('nv7_state', JSON.stringify(state));
}

// ============================================================
// SCREENS
// ============================================================
function showScreen(id, btn) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if (btn) {
    btn.closest('.bottom-nav').querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }
}

// ============================================================
// WEATHER (FIX #2 & #3: real time)
// ============================================================
function updateWeather() {
  const hour = new Date().getHours();
  let icon, desc, tempApprox;

  // Sun alert: only between 10:00 and 16:00 (FIX #3)
  const sunAlert = document.getElementById('sun-alert');
  if (hour >= 10 && hour < 16) {
    sunAlert.classList.add('visible');
  } else {
    sunAlert.classList.remove('visible');
  }

  // Try geolocation weather
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
      const lat = pos.coords.latitude;
      const lon = pos.coords.longitude;
      fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=apparent_temperature&timezone=auto`)
        .then(r => r.json())
        .then(data => {
          const temp = Math.round(data.current_weather.temperature);
          const wcode = data.current_weather.weathercode;
          const isDay = data.current_weather.is_day;
          const ic = wCodeToIcon(wcode, isDay);
          document.getElementById('weather-temp').textContent = `${temp}°C`;
          document.getElementById('weather-icon').textContent = ic;
          document.getElementById('weather-desc').textContent = wCodeToDesc(wcode);
        })
        .catch(() => setFallbackWeather(hour));
    }, () => setFallbackWeather(hour));
  } else {
    setFallbackWeather(hour);
  }
}

function setFallbackWeather(hour) {
  // Time-based fallback (FIX #2: not always 18°)
  let icon, desc, temp;
  if (hour >= 6 && hour < 12) { icon='🌤️'; desc='Mañana'; temp=14; }
  else if (hour >= 12 && hour < 16) { icon='☀️'; desc='Mediodía'; temp=20; }
  else if (hour >= 16 && hour < 20) { icon='🌅'; desc='Tarde'; temp=17; }
  else { icon='🌙'; desc='Noche'; temp=10; }
  document.getElementById('weather-icon').textContent = icon;
  document.getElementById('weather-temp').textContent = `~${temp}°C`;
  document.getElementById('weather-desc').textContent = desc + ' · Mar del Plata';
}

function wCodeToIcon(code, isDay) {
  if (code === 0) return isDay ? '☀️' : '🌙';
  if (code <= 2) return isDay ? '🌤️' : '🌙';
  if (code <= 3) return '☁️';
  if (code <= 49) return '🌫️';
  if (code <= 67) return '🌧️';
  if (code <= 77) return '❄️';
  if (code <= 82) return '🌦️';
  if (code <= 99) return '⛈️';
  return '🌡️';
}
function wCodeToDesc(code) {
  if (code === 0) return 'Despejado';
  if (code <= 2) return 'Parcialmente nublado';
  if (code <= 3) return 'Nublado';
  if (code <= 49) return 'Neblina';
  if (code <= 67) return 'Lluvia';
  if (code <= 77) return 'Nieve';
  if (code <= 82) return 'Lluvia intermitente';
  return 'Tormenta';
}

// ============================================================
// FOLDERS
// ============================================================
function renderFolders() {
  const grid = document.getElementById('folders-grid');
  grid.className = 'folders-grid' + (state.layout === '3' ? ' cols3' : state.layout === 'list' ? ' list' : '');
  grid.innerHTML = '';
  const visible = state.folders.filter(f => !f.hidden);
  visible.forEach(f => {
    const count = countEntries(f);
    const card = document.createElement('div');
    card.className = `folder-card fc-${f.color}`;
    card.innerHTML = `
      <div class="folder-icon">${f.icon}</div>
      <div class="folder-name">${f.name}</div>
      <div class="folder-count">${count} entrada${count !== 1 ? 's' : ''}</div>
      <div class="folder-accent fa-${f.color}"></div>
    `;
    // FIX #1 & #11: open only on short tap, not on scroll
    let tapStartY = 0, tapStartTime = 0, moved = false;
    card.addEventListener('touchstart', e => {
      tapStartY = e.touches[0].clientY;
      tapStartTime = Date.now();
      moved = false;
    }, {passive: true});
    card.addEventListener('touchmove', e => {
      if (Math.abs(e.touches[0].clientY - tapStartY) > 8) moved = true;
    }, {passive: true});
    card.addEventListener('touchend', e => {
      const elapsed = Date.now() - tapStartTime;
      if (!moved && elapsed < 500) openFolder(f.id);
    });
    card.addEventListener('click', e => {
      // fallback for desktop
      if (!('ontouchstart' in window)) openFolder(f.id);
    });
    grid.appendChild(card);
  });
}

function countEntries(f) {
  let n = f.entries ? f.entries.length : 0;
  if (f.sub) f.sub.forEach(s => { n += s.entries ? s.entries.length : 0; });
  return n;
}

function findFolder(id) {
  for (const f of state.folders) {
    if (f.id === id) return f;
    if (f.sub) for (const s of f.sub) { if (s.id === id) return s; }
  }
  return null;
}

function openFolder(id) {
  const f = findFolder(id);
  if (!f) return;
  state.currentFolder = id;
  document.getElementById('folder-title').textContent = f.icon + ' ' + f.name;
  const colorEl = document.getElementById('folder-header-color');
  colorEl.className = 'folder-header-color fa-' + f.color;

  renderFolderEntries(f);
  showScreen('folder-screen', null);
}

function renderFolderEntries(f) {
  const cont = document.getElementById('folder-entries');
  cont.innerHTML = '';

  // Sub-folders
  if (f.sub && f.sub.length > 0) {
    const sg = document.createElement('div');
    sg.innerHTML = '<div class="section-title" style="margin-bottom:8px;">Subcarpetas</div>';
    const sgrid = document.createElement('div');
    sgrid.className = 'folders-grid';
    f.sub.forEach(s => {
      const c = document.createElement('div');
      c.className = `folder-card fc-${s.color}`;
      c.innerHTML = `<div class="folder-icon">${s.icon}</div><div class="folder-name">${s.name}</div><div class="folder-count">${s.entries.length} entradas</div><div class="folder-accent fa-${s.color}"></div>`;
      let moved2 = false, tapY2 = 0;
      c.addEventListener('touchstart', e => { tapY2 = e.touches[0].clientY; moved2 = false; }, {passive:true});
      c.addEventListener('touchmove', e => { if (Math.abs(e.touches[0].clientY - tapY2) > 8) moved2 = true; }, {passive:true});
      c.addEventListener('touchend', () => { if (!moved2) openFolder(s.id); });
      c.addEventListener('click', () => { if (!('ontouchstart' in window)) openFolder(s.id); });
      sgrid.appendChild(c);
    });
    sg.appendChild(sgrid);
    cont.appendChild(sg);
    const divider = document.createElement('div');
    divider.style.cssText = 'border-top:1px solid var(--border);margin:12px 0;';
    cont.appendChild(divider);
  }

  if (!f.entries || f.entries.length === 0) {
    cont.insertAdjacentHTML('beforeend', `<div class="empty-state"><div class="empty-icon">${f.icon}</div><div>Sin entradas todavía.</div><div style="margin-top:8px;font-size:0.82em;">Escribí o hablá para agregar.</div></div>`);
    return;
  }
  [...f.entries].reverse().forEach((entry, i) => {
    const realIdx = f.entries.length - 1 - i;
    const d = document.createElement('div');
    d.className = 'entry-card';
    const dateStr = entry.date ? new Date(entry.date).toLocaleString('es-AR', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '';
    d.innerHTML = `
      <div style="flex:1">
        <div class="entry-text" id="et-${realIdx}">${entry.text}</div>
        <div class="entry-date">${dateStr}</div>
        ${entry.reminder ? `<div style="font-size:0.75em;color:var(--yellow);margin-top:4px;">⏰ ${new Date(entry.reminder).toLocaleString('es-AR')}</div>` : ''}
      </div>
      <div class="entry-actions">
        <button class="entry-btn" onclick="speakEntry('${realIdx}')" title="Leer">🔊</button>
        <button class="entry-btn" onclick="editEntry(${realIdx})" title="Editar">✏️</button>
        <button class="entry-btn" onclick="deleteEntry(${realIdx})" title="Borrar">🗑️</button>
      </div>
    `;
    cont.appendChild(d);
  });
}

function saveEntry() {
  const input = document.getElementById('entry-input');
  const text = input.value.trim();
  if (!text) return;
  const f = findFolder(state.currentFolder);
  if (!f) return;
  f.entries.push({ text, date: new Date().toISOString() });
  saveState();
  renderFolders();
  renderFolderEntries(f);
  input.value = '';
  toast('✅ Guardado');
}

function deleteEntry(idx) {
  const f = findFolder(state.currentFolder);
  if (!f) return;
  if (!confirm('¿Eliminar esta entrada?')) return;
  f.entries.splice(idx, 1);
  saveState();
  renderFolders();
  renderFolderEntries(f);
}

function editEntry(idx) {
  const f = findFolder(state.currentFolder);
  if (!f) return;
  const el = document.getElementById(`et-${idx}`);
  el.contentEditable = 'true';
  el.style.outline = '1px solid var(--accent)';
  el.style.borderRadius = '4px';
  el.focus();
  el.onblur = () => {
    f.entries[idx].text = el.textContent;
    el.contentEditable = 'false';
    el.style.outline = '';
    saveState();
    toast('✏️ Editado');
  };
}

function speakEntry(idx) {
  const f = findFolder(state.currentFolder);
  if (!f) return;
  const text = f.entries[idx]?.text || '';
  const utt = new SpeechSynthesisUtterance(text);
  utt.lang = 'es-AR';
  speechSynthesis.speak(utt);
}

function closeFolder() {
  showScreen('home', null);
  renderFolders();
}

// ============================================================
// FAB DRAG (FIX #4)
// ============================================================
(function() {
  const fab = document.getElementById('fab');
  let isDragging = false, startX, startY, fabX, fabY, dragMoved = false;
  let longPressTimer = null;

  function getFabPos() {
    const rect = fab.getBoundingClientRect();
    return { x: rect.left, y: rect.top };
  }

  fab.addEventListener('touchstart', e => {
    const touch = e.touches[0];
    startX = touch.clientX;
    startY = touch.clientY;
    const pos = getFabPos();
    fabX = pos.x;
    fabY = pos.y;
    isDragging = false;
    dragMoved = false;

    longPressTimer = setTimeout(() => {
      toggleHandsfree();
    }, 700);
  }, {passive: true});

  fab.addEventListener('touchmove', e => {
    const touch = e.touches[0];
    const dx = touch.clientX - startX;
    const dy = touch.clientY - startY;

    if (!isDragging && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
      isDragging = true;
      dragMoved = true;
      clearTimeout(longPressTimer);
      fab.classList.add('dragging');
      fab.style.transition = 'none';
      fab.style.bottom = 'auto';
      fab.style.right = 'auto';
    }

    if (isDragging) {
      e.preventDefault();
      let nx = fabX + dx;
      let ny = fabY + dy;
      const mw = window.innerWidth - fab.offsetWidth;
      const mh = window.innerHeight - fab.offsetHeight;
      nx = Math.max(0, Math.min(nx, mw));
      ny = Math.max(0, Math.min(ny, mh));
      fab.style.left = nx + 'px';
      fab.style.top = ny + 'px';
    }
  }, {passive: false});

  fab.addEventListener('touchend', e => {
    clearTimeout(longPressTimer);
    fab.classList.remove('dragging');
    fab.style.transition = '';
    if (!dragMoved) {
      micTap();
    }
    isDragging = false;
  });

  fab.addEventListener('click', e => {
    if (!('ontouchstart' in window)) micTap();
  });
})();

// ============================================================
// MICROPHONE (FIX #5, #10: WhatsApp-style timing)
// ============================================================
let recognition = null;
let micMode = 'idle'; // idle | single | handsfree
let micTarget = 'fab'; // fab | entry | nv | driver
let micTimerInterval = null;
let micSeconds = 0;
let silenceTimer = null;
let finalTranscript = '';
let micStopped = false; // FLAG anti-loop

function setupRecognition() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) return null;
  const r = new SpeechRecognition();
  r.lang = 'es-AR';
  r.continuous = false; // NO continuous: evita el loop
  r.interimResults = true;
  r.maxAlternatives = 1;
  return r;
}

function micTap() {
  if (micMode === 'idle') startMic('fab', false);
  else stopMic();
}

function micForEntry() {
  if (micMode === 'idle') startMic('entry', false);
  else stopMic();
}

function micForNV() {
  if (micMode === 'idle') startMic('nv', false);
  else stopMic();
}

function startMic(target, handsfree) {
  // Limpiar cualquier instancia previa
  if (recognition) { try { recognition.abort(); } catch(e){} recognition = null; }
  micStopped = false;

  recognition = setupRecognition();
  if (!recognition) { toast('Micrófono no disponible en este navegador'); return; }

  // Para manos libres, usar continuous=true
  if (handsfree) recognition.continuous = true;

  micTarget = target;
  micMode = handsfree ? 'handsfree' : 'single';
  finalTranscript = '';
  micSeconds = 0;

  document.getElementById('mic-modal').classList.add('open');
  document.getElementById('mic-status-text').textContent = handsfree ? '🟣 Manos libres activo' : '🔴 Escuchando...';
  document.getElementById('mic-transcript-text').textContent = '';
  document.getElementById('mic-timer').textContent = '0s';

  clearInterval(micTimerInterval);
  micTimerInterval = setInterval(() => {
    micSeconds++;
    document.getElementById('mic-timer').textContent = micSeconds + 's';
  }, 1000);

  document.getElementById('fab').classList.add('listening');

  recognition.onresult = e => {
    if (micStopped) return;
    let interim = '';
    clearTimeout(silenceTimer);
    for (let i = e.resultIndex; i < e.results.length; i++) {
      if (e.results[i].isFinal) {
        finalTranscript += e.results[i][0].transcript + ' ';
      } else {
        interim = e.results[i][0].transcript;
      }
    }
    document.getElementById('mic-transcript-text').textContent = (finalTranscript + interim).trim();

    // Silencio de 2.5s → parar (modo normal)
    if (micMode === 'single' && finalTranscript.trim()) {
      silenceTimer = setTimeout(() => { if (!micStopped) stopMic(); }, 2500);
    }
  };

  recognition.onerror = e => {
    if (micStopped) return;
    if (e.error === 'no-speech') {
      // No hubo voz — cerrar limpio sin error
      stopMic(); return;
    }
    if (e.error !== 'aborted') toast('Error de micrófono: ' + e.error);
    stopMic();
  };

  recognition.onend = () => {
    if (micStopped) return;
    if (micMode === 'handsfree' && !micStopped) {
      // Manos libres: reiniciar solo si no fue detenido
      setTimeout(() => {
        if (!micStopped && micMode === 'handsfree') {
          try { recognition.start(); } catch(e){}
        }
      }, 400);
    } else {
      // Modo normal: finalizar
      micStopped = true;
      finalizeMic();
    }
  };

  try { recognition.start(); }
  catch(e) { toast('No se pudo iniciar el micrófono'); micMode = 'idle'; }
}

function stopMic() {
  if (micStopped) return;
  micStopped = true;
  clearTimeout(silenceTimer);
  clearInterval(micTimerInterval);
  micMode = 'idle';
  if (recognition) { try { recognition.stop(); } catch(e){} }
  finalizeMic();
}

function finalizeMic() {
  document.getElementById('mic-modal').classList.remove('open');
  document.getElementById('fab').classList.remove('listening');
  document.getElementById('fab').classList.remove('handsfree');

  const text = finalTranscript.trim();
  if (!text) return;

  if (micTarget === 'entry') {
    // Dentro de carpeta: poner en input + verificar mismatch
    const inp = document.getElementById('entry-input');
    inp.value = (inp.value + ' ' + text).trim();
    checkContentMismatch(text);
  } else if (micTarget === 'nv') {
    document.getElementById('nv-input').value = text;
    sendNV();
  } else if (micTarget === 'driver') {
    // Modo conductor: motor NV completo
    document.getElementById('driver-transcript').textContent = text;
    document.getElementById('driver-status').textContent = '🤔 Procesando...';
    nvProcesar(text).then(result => {
      if (result) nvHandleResult(result, text);
    });
  } else {
    // Botón rojo desde inicio: motor NV completo
    nvProcesar(text).then(result => {
      if (result) nvHandleResult(result, text);
    });
  }
}

// ============================================================
// HANDSFREE (FIX #5)
// ============================================================
let isHandsfree = false;

function toggleHandsfree() {
  if (isHandsfree) {
    stopHandsfree();
  } else {
    isHandsfree = true;
    document.getElementById('handsfree-bar').classList.add('open');
    document.getElementById('fab').classList.add('handsfree');
    startMic('fab', true);
    toast('🟣 Manos libres activado');
  }
}

function stopHandsfree() {
  isHandsfree = false;
  micMode = 'idle';
  document.getElementById('handsfree-bar').classList.remove('open');
  document.getElementById('fab').classList.remove('handsfree');
  stopMic();
  toast('Manos libres desactivado');
}

// ============================================================
// MOTOR NV — COMANDOS DE VOZ (fusión v6+v7)
// ============================================================
const SYNS = {
  guardar:   ['guardá','guardar','anotá','anotar','recordá','recordar','apuntá','apuntar','haceme acordar','poneme','meteme'],
  mensaje:   ['mandá','mandar','enviá','enviar','avisale','avisar','decile','mensaje','escribile','whatsapp','wsp'],
  llamar:    ['llamá','llamar','contactá','telefoneá','marcá'],
  maps:      ['llevame','llevar','cómo llego','navegar','ir a','dónde hay','cerca','dónde queda'],
  buscar:    ['buscá','buscar','encontrá','mostrame','qué tengo','qué anoté','qué guardé'],
  conductor: ['modo conductor','estoy manejando','modo auto'],
  clima:     ['clima','tiempo','llueve','temperatura'],
  youtube:   ['youtube','video','buscá en youtube','poné música','poneme','buscame en youtube'],
  ayuda:     ['ayuda','instrucciones','cómo funciona','cómo uso'],
};

// Contexto entre comandos
const ctx = { lastIntent: null, lastEntity: null, lastAction: null, lastRaw: '' };

function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }

function nvDetectAction(t) {
  for (const [a, syns] of Object.entries(SYNS))
    if (syns.some(x => t.includes(x))) return a;
  return null;
}

function nvDetectEntity(t) {
  for (const c of (state.contacts || []))
    if (t.includes(c.name.toLowerCase())) return c;
  const m = t.match(/(?:a|para)\s+([a-záéíóúñ]{3,})/i);
  return m ? { name: m[1], phone: null } : null;
}

function nvClassify(raw) {
  const t = raw.toLowerCase().trim();
  // Contexto: referencias a lo último
  if (['hacelo','mandalo','guardalo','lo mismo','eso','también'].some(x => t.includes(x)) && ctx.lastIntent)
    return { type: 'contexto' };
  if ((t.startsWith('no,') || t.startsWith('no ')) && ctx.lastAction)
    return { type: 'correccion' };

  const action = nvDetectAction(t);
  if (action === 'conductor') return { type: 'conductor' };
  if (action === 'clima')     return { type: 'clima' };
  if (action === 'ayuda')     return { type: 'ayuda' };
  if (action === 'youtube') {
    let q = t; SYNS.youtube.forEach(s => { q = q.replace(s, ''); });
    return { type: 'youtube', query: q.trim() };
  }
  if (action === 'maps') {
    let q = t; SYNS.maps.forEach(s => { q = q.replace(s, ''); });
    return { type: 'maps', query: q.trim() };
  }
  if (action === 'buscar') return { type: 'busqueda', query: t };
  if (action === 'mensaje') {
    const e = nvDetectEntity(t);
    let c = t; SYNS.mensaje.forEach(s => { c = c.replace(s, ''); });
    if (e) c = c.replace(e.name.toLowerCase(), '');
    return { type: 'comando', action: 'mensaje', entity: e, content: c.replace(/[:,\-]/g, '').trim() };
  }
  if (action === 'llamar') return { type: 'comando', action: 'llamar', entity: nvDetectEntity(t) };
  if (action === 'guardar') {
    let c = t; SYNS.guardar.forEach(s => { c = c.replace(s, ''); });
    return { type: 'guardar', content: c.replace(/[:,\-]/g, '').trim() };
  }
  // Pregunta → IA
  if (/^(qué|cómo|cuál|por qué|cuándo|cuánto|dónde|quién|explicá|contame|decime)/.test(t) && raw.length > 10)
    return { type: 'ia', query: raw };
  // Todo lo demás → guardar con confirmación
  if (raw.trim().length >= 3) return { type: 'auto_guardar' };
  return { type: 'unknown' };
}

async function nvEjecutar(intent, raw) {
  const { type, action, entity, content, query } = intent;
  if (type === 'contexto') return { msg: `Repito: ${ctx.lastRaw}`, action: 'contexto' };
  if (type === 'correccion') return { msg: 'OK, ¿cómo lo hacemos entonces?', action: 'esperando' };
  if (type === 'conductor') return { msg: null, action: 'conductor' };
  if (type === 'clima') {
    const h = new Date().getHours();
    const sunny = h >= 10 && h <= 16;
    const tempEl = document.getElementById('weather-temp');
    const temp = tempEl ? tempEl.textContent : '--°C';
    return { msg: `Mar del Plata, ${temp}.` + (sunny ? ' Sol fuerte, recordá cubrirte.' : ' Sin sol intenso ahora.'), action: 'clima' };
  }
  if (type === 'youtube') return { msg: `Abriendo YouTube: ${query || 'inicio'}`, action: 'youtube', query };
  if (type === 'maps') return { msg: `Abriendo Maps: ${query || 'cerca'}`, action: 'maps', query };
  if (type === 'busqueda') {
    const results = nvSearch(raw);
    if (!results.length) return { msg: 'No encontré nada con eso.', action: 'busqueda_vacia' };
    let msg = `Encontré ${results.length} entrada${results.length > 1 ? 's' : ''}:\n`;
    results.slice(0, 4).forEach(r => { msg += `\n• ${r.icon} ${r.text.slice(0, 50)}`; });
    return { msg, action: 'busqueda_ok' };
  }
  if (type === 'guardar') {
    return { msg: null, action: 'confirm_save', content: content || raw };
  }
  if (type === 'auto_guardar') {
    return { msg: null, action: 'confirm_save', content: raw };
  }
  if (type === 'comando') {
    if (action === 'mensaje') {
      if (!entity) return { msg: '¿A quién le mando el mensaje?', action: 'esp_entidad' };
      if (!content || content.length < 2) return { msg: `¿Qué le digo a ${cap(entity.name)}?`, action: 'esp_contenido', entity };
      return { msg: `Abriendo WhatsApp para ${cap(entity.name)}`, action: 'whatsapp', entity, content };
    }
    if (action === 'llamar') {
      if (!entity) return { msg: '¿A quién llamo?', action: 'esp_entidad' };
      if (!entity.phone) return { msg: `No tengo el número de ${cap(entity.name)}. Agregalo en Config.`, action: 'sin_numero' };
      return { msg: `Llamando a ${cap(entity.name)}`, action: 'llamar', entity };
    }
  }
  if (type === 'ia') return { msg: null, action: 'ia', query: raw };
  return { msg: 'No entendí. ¿Guardamos esto, buscamos algo o abrimos alguna app?', action: 'error_suave' };
}

async function nvProcesar(raw) {
  if (!raw.trim()) return null;
  const intent = nvClassify(raw);
  const result = await nvEjecutar(intent, raw);
  ctx.lastIntent = intent.action || intent.type;
  ctx.lastEntity = intent.entity || ctx.lastEntity;
  ctx.lastAction = result.action;
  ctx.lastRaw = raw;
  return result;
}

async function nvHandleResult(result, raw) {
  const { action, msg, query, entity, content } = result;
  if (action === 'conductor') { activateConductorMode(); speak('Modo conductor activado'); return; }
  if (action === 'maps') { openMaps(query); speak('Abriendo Maps'); return; }
  if (action === 'youtube') { openYT(query); speak('Abriendo YouTube'); return; }
  if (action === 'whatsapp') {
    if (entity?.phone) {
      // Leer mensaje y pedir confirmación
      speak(`Le voy a mandar a ${entity.name}: ${content}. ¿Confirmás?`);
      showWAConfirm(entity, content);
    } else if (entity?.name) {
      speak(`No tengo el número de ${entity.name}. Agregalo en Configuración.`);
      toast(`Agregá el número de ${entity.name} en Config → Contactos`);
    } else {
      speak('¿A quién le mando el mensaje?');
    }
    return;
  }
  if (action === 'llamar') { window.location.href = `tel:${entity.phone}`; speak(`Llamando a ${entity.name}`); return; }
  if (action === 'confirm_save') { autoClassifyWithConfirm(content || raw); return; }
  if (action === 'ia') {
    // Mostrar en NV chat
    showScreen('nv-screen', null);
    appendNVMsg(raw, 'user');
    const thinking = appendNVMsg('Pensando...', 'nv');
    try {
      const resp = await callNVAI(raw);
      thinking.textContent = resp;
      speak(resp.slice(0, 150));
    } catch(e) {
      const fb = 'Sin internet en este momento.';
      thinking.textContent = fb;
      speak(fb);
    }
    return;
  }
  if (msg) { speak(msg); toast(msg); }
}

function nvSearch(query) {
  const q = query.toLowerCase().replace(/qué (tengo|anoté|guardé)|mostrame|buscá/g, '').trim();
  if (!q || q.length < 2) return [];
  const words = q.split(/\s+/).filter(w => w.length > 1);
  const results = [];
  function searchIn(f) {
    (f.entries || []).forEach(e => {
      if (words.some(w => e.text.toLowerCase().includes(w)))
        results.push({ folder: f.name, icon: f.icon, text: e.text });
    });
    if (f.sub) f.sub.forEach(s => searchIn(s));
  }
  state.folders.forEach(f => searchIn(f));
  return results.slice(0, 10);
}

// WhatsApp con confirmación por voz
function showWAConfirm(entity, content) {
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:500;display:flex;align-items:flex-end;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:var(--bg2);border-radius:20px 20px 0 0;padding:20px 16px 36px;width:100%;max-width:500px;border-top:2px solid #25d366;">
      <div style="font-size:0.85em;color:var(--text2);margin-bottom:6px;">💬 Mensaje para <b>${cap(entity.name)}</b></div>
      <textarea id="wa-confirm-text" style="width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;color:var(--text);font-size:0.95em;outline:none;min-height:80px;font-family:inherit;margin-bottom:12px;">${content}</textarea>
      <div style="display:flex;gap:8px;">
        <button onclick="this.closest('div[style*=fixed]').remove();speak('Cancelado')" style="flex:1;background:var(--bg3);color:var(--text);border:none;border-radius:10px;padding:13px;cursor:pointer;">❌ Cancelar</button>
        <button onclick="sendWAConfirmed('${entity.phone}',this)" style="flex:1;background:#25d366;color:#0f0f1a;border:none;border-radius:10px;padding:13px;font-weight:700;cursor:pointer;">✅ Enviar</button>
      </div>
    </div>
  `;
  document.body.appendChild(overlay);
}

function sendWAConfirmed(phone, btn) {
  const text = document.getElementById('wa-confirm-text').value.trim();
  btn.closest('div[style*="fixed"]').remove();
  openWA(phone, text);
  speak('Mensaje enviado');
}

function speak(text) {
  if (!window.speechSynthesis || !text) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'es-AR'; u.rate = 0.92;
  speechSynthesis.speak(u);
}

function openYT(q) {
  window.open(q ? `https://www.youtube.com/results?search_query=${encodeURIComponent(q)}` : 'https://youtube.com', '_blank');
}

async function callNVAI(prompt) {
  const allEntries = [];
  state.folders.forEach(f => {
    f.entries.forEach(e => allEntries.push(`[${f.name}]: ${e.text}`));
    if (f.sub) f.sub.forEach(s => s.entries.forEach(e => allEntries.push(`[${f.name}/${s.name}]: ${e.text}`)));
  });
  const resp = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'claude-sonnet-4-20250514', max_tokens: 800,
      system: `Sos NV, secretario inteligente de Gastón (Tonga), técnico multirubro de Mar del Plata. Respondé corto, en español rioplatense. Sus notas:\n${allEntries.slice(-20).join('\n')}`,
      messages: [{ role: 'user', content: prompt }]
    })
  });
  const data = await resp.json();
  return data.content?.[0]?.text || 'No pude responder.';
}

// Modo conductor
function activateConductorMode() {
  showScreen('driver-screen', null);
  renderConductorQuick();
}

function renderConductorQuick() {
  const contacts = (state.contacts || []).slice(0, 2);
  const cont = document.getElementById('conductor-quick');
  if (!cont) return;
  cont.innerHTML = `
    <div class="cq" onclick="openMaps('')"><div class="cq-icon">📍</div><div class="cq-label">Maps</div></div>
    <div class="cq" onclick="openWA('','')"><div class="cq-icon">💬</div><div class="cq-label">WhatsApp</div></div>
    ${contacts.map(c => `<div class="cq" onclick="openWA('${c.phone}','Hola ${c.name}!')"><div class="cq-icon">📞</div><div class="cq-label">${c.name}</div></div>`).join('')}
  `;
}

// ============================================================
// AUTO CLASSIFY CON CONFIRMACIÓN
// ============================================================
const classifyRules = [
  { keywords: ['comprar','compra','traer','necesito','falta','faltan','ferretería','mercado','super','materiales'], folder: 'f10' },
  { keywords: ['salud','médico','doctor','pastilla','medicamento','turno','hospital','dolor','sol','crema','lupus'], folder: 'f5' },
  { keywords: ['auto','coche','vehículo','nafta','aceite','neumático','goma','camión','camioneta','batería','mecánico'], folder: 'f2' },
  { keywords: ['obra','construcción','cemento','ladrillo','pintura','techo','pared','piso','quincho'], folder: 'f1' },
  { keywords: ['dinero','plata','pago','factura','deuda','cobrar','ingreso','cobro','préstamo','presupuesto','gasto'], folder: 'f4' },
  { keywords: ['proyecto','invento','idea','cama','poleas','patente','prototipo','3d','diseño','mecanismo'], folder: 'f6' },
  { keywords: ['música','dj','set','canción','tema','mix','cumbia','colombiana','tango','playlist','track','mezcla'], folder: 'f7' },
  { keywords: ['soñé','sueño','soñar','dormí','dormido'], folder: 'f11' },
  { keywords: ['señal','sincronía','número','espiritual','energía','ángel','universo','coincidencia'], folder: 'f12' },
  { keywords: ['herramienta','martillo','destornillador','alicate','taladro','amoladora','nivel','llave','prestá','presté'], folder: 'f9' },
  { keywords: ['hogar','casa','cocina','living','limpieza','heladera','mueble','electrodoméstico'], folder: 'f3' },
  { keywords: ['youtube','video','link','url','instagram','http','www','tiktok','reel'], folder: 'f14' },
  { keywords: ['meditar','meditación','chakra','reiki'], folder: 'f8' },
];

function detectFolder(text) {
  const lower = text.toLowerCase();
  for (const rule of classifyRules) {
    if (rule.keywords.some(k => lower.includes(k))) return rule.folder;
  }
  return null; // sin clasificar
}

// Desde botón rojo en INICIO: clasificar y confirmar antes de guardar
function autoClassifyWithConfirm(text) {
  const folderId = detectFolder(text);
  const f = folderId ? findFolder(folderId) : null;
  const folderName = f ? `${f.icon} ${f.name}` : null;

  showConfirmSave(text, folderId, folderName);
}

// Dentro de carpeta: verificar si el contenido NO tiene que ver
function checkContentMismatch(text) {
  const currentF = findFolder(state.currentFolder);
  if (!currentF) return;

  const detectedId = detectFolder(text);
  if (!detectedId || detectedId === state.currentFolder) return; // ok, coincide o no detectó nada

  // Detectó otra carpeta — preguntar
  const detectedF = findFolder(detectedId);
  showMismatchToast(text, currentF, detectedF);
}

function showMismatchToast(text, currentF, detectedF) {
  // Crear alerta discreta
  const banner = document.createElement('div');
  banner.style.cssText = `
    position:fixed;bottom:calc(var(--nav-h) + 75px);left:12px;right:12px;
    background:#1e2a1e;border:1px solid #27ae60;border-radius:14px;
    padding:12px 14px;z-index:500;font-size:0.85em;
  `;
  banner.innerHTML = `
    <div style="margin-bottom:8px;">⚠️ Esto suena más a <b>${detectedF.icon} ${detectedF.name}</b>. ¿Dónde guardamos?</div>
    <div style="display:flex;gap:8px;">
      <button onclick="this.closest('div[style]').remove()" 
        style="flex:1;background:var(--accent2);color:var(--green);border:none;border-radius:8px;padding:8px;cursor:pointer;font-size:0.85em;">
        Acá en ${currentF.icon} ${currentF.name}
      </button>
      <button onclick="moveEntryToFolder('${text}','${detectedF.id}',this)" 
        style="flex:1;background:var(--accent);color:white;border:none;border-radius:8px;padding:8px;cursor:pointer;font-size:0.85em;">
        Mover a ${detectedF.icon} ${detectedF.name}
      </button>
    </div>
  `;
  document.body.appendChild(banner);
  setTimeout(() => { if (banner.parentNode) banner.remove(); }, 12000);
}

function moveEntryToFolder(text, targetFolderId, btn) {
  btn.closest('div[style]').remove();
  // Quitar del input actual
  const inp = document.getElementById('entry-input');
  inp.value = inp.value.replace(text, '').trim();
  // Guardar en la carpeta destino
  const f = findFolder(targetFolderId);
  if (f) {
    f.entries.push({ text, date: new Date().toISOString() });
    saveState();
    renderFolders();
    toast(`✅ Guardado en ${f.icon} ${f.name}`);
  }
}

// Modal de confirmación para guardar desde botón rojo
function showConfirmSave(text, folderId, folderName) {
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:500;display:flex;align-items:flex-end;justify-content:center;';

  const allFolderOptions = state.folders.filter(f => !f.hidden).map(f =>
    `<option value="${f.id}">${f.icon} ${f.name}</option>`
  ).join('');

  overlay.innerHTML = `
    <div style="background:var(--bg2);border-radius:20px 20px 0 0;padding:20px 16px 36px;width:100%;max-width:500px;border-top:2px solid var(--border);">
      <div style="font-weight:700;font-size:1em;margin-bottom:10px;">💾 ¿Dónde guardamos esto?</div>
      <div style="background:var(--bg3);border-radius:10px;padding:10px 12px;font-size:0.88em;margin-bottom:14px;color:var(--text2);">"${text}"</div>
      ${folderName ? `<div style="margin-bottom:10px;font-size:0.85em;color:var(--green);">📂 Detecté: <b>${folderName}</b></div>` : '<div style="margin-bottom:10px;font-size:0.85em;color:var(--yellow);">⚠️ No sé en qué carpeta va. Elegí una:</div>'}
      <select id="confirm-folder-select" style="width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;color:var(--text);font-size:0.95em;margin-bottom:12px;outline:none;">
        ${allFolderOptions}
      </select>
      <div style="display:flex;gap:10px;">
        <button onclick="this.closest('div[style*=fixed]').remove()" style="flex:1;background:var(--bg3);color:var(--text);border:none;border-radius:10px;padding:13px;cursor:pointer;">Cancelar</button>
        <button onclick="confirmSaveEntry('${encodeURIComponent(text)}',this)" style="flex:1;background:var(--accent);color:white;border:none;border-radius:10px;padding:13px;font-weight:700;cursor:pointer;">Guardar aquí</button>
      </div>
    </div>
  `;

  // Pre-seleccionar la carpeta detectada
  document.body.appendChild(overlay);
  if (folderId) {
    const sel = document.getElementById('confirm-folder-select');
    if (sel) sel.value = folderId;
  }
}

function confirmSaveEntry(encodedText, btn) {
  const text = decodeURIComponent(encodedText);
  const sel = document.getElementById('confirm-folder-select');
  const folderId = sel ? sel.value : null;
  const overlay = btn.closest('div[style*="fixed"]');
  if (overlay) overlay.remove();

  if (!folderId) { toast('Elegí una carpeta'); return; }
  const f = findFolder(folderId);
  if (f) {
    f.entries.push({ text, date: new Date().toISOString() });
    saveState();
    renderFolders();
    toast(`✅ Guardado en ${f.icon} ${f.name}`);
  }
}

// Mantener autoClassify para usos internos simples
function autoClassify(text) {
  autoClassifyWithConfirm(text);
}

// ============================================================
// DRIVER MODE
// ============================================================
function driverMicTap() {
  if (micMode === 'idle') startMic('driver', false);
  else stopMic();
}

function processDriverCommand(text) {
  const lower = text.toLowerCase();
  if (lower.includes('maps') || lower.includes('mapa') || lower.includes('llevame') || lower.includes('navega')) {
    const dest = lower.replace(/llevame a|llevame|buscá|busca|maps|mapa|navega(r)?/gi, '').trim();
    openMaps(dest || 'mi ubicación');
    document.getElementById('driver-status').textContent = '🗺️ Abriendo Maps...';
  } else if (lower.includes('whatsapp')) {
    openWA();
    document.getElementById('driver-status').textContent = '💬 Abriendo WhatsApp...';
  } else {
    // Clasificar y confirmar
    document.getElementById('driver-status').textContent = '🤔 Clasificando...';
    const folderId = detectFolder(text);
    const f = folderId ? findFolder(folderId) : null;
    const folderName = f ? `${f.icon} ${f.name}` : 'Sin clasificar';

    // Mostrar confirmación en pantalla conductor
    const statusEl = document.getElementById('driver-status');
    statusEl.innerHTML = `
      <div style="margin-bottom:12px;">Detecté: <b>${folderName}</b></div>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <button onclick="driverConfirmSave('${encodeURIComponent(text)}','${folderId||''}',this)" 
          style="background:#27ae60;color:white;border:none;border-radius:12px;padding:12px 20px;font-size:1em;cursor:pointer;">
          ✅ Guardar aquí
        </button>
        <button onclick="driverChooseFolder('${encodeURIComponent(text)}',this)"
          style="background:#e67e22;color:white;border:none;border-radius:12px;padding:12px 20px;font-size:1em;cursor:pointer;">
          📁 Elegir carpeta
        </button>
        <button onclick="document.getElementById('driver-status').textContent='Tocá el botón y hablá'"
          style="background:rgba(255,255,255,0.15);color:white;border:none;border-radius:12px;padding:12px 20px;font-size:1em;cursor:pointer;">
          ❌ Cancelar
        </button>
      </div>
    `;
  }
}

function driverConfirmSave(encodedText, folderId, btn) {
  const text = decodeURIComponent(encodedText);
  const targetId = folderId || 'f6';
  const f = findFolder(targetId);
  if (f) {
    f.entries.push({ text, date: new Date().toISOString() });
    saveState();
    renderFolders();
    document.getElementById('driver-status').textContent = `✅ Guardado en ${f.icon} ${f.name}`;
    document.getElementById('driver-transcript').textContent = '';
    setTimeout(() => { document.getElementById('driver-status').textContent = 'Tocá el botón y hablá'; }, 3000);
  }
}

function driverChooseFolder(encodedText, btn) {
  const text = decodeURIComponent(encodedText);
  document.getElementById('driver-status').textContent = 'Tocá el botón y hablá';
  showConfirmSave(text, null, null);
}

// ============================================================
// QUICK LINKS
// ============================================================
function openMaps(query) {
  const q = query || 'ferretería cerca';
  window.open('https://maps.google.com/?q=' + encodeURIComponent(q), '_blank');
}

// FIX #9: WhatsApp opens contact directly with message
function openWA(phone, message) {
  if (phone) {
    const p = phone.replace(/\D/g, '');
    const msg = encodeURIComponent(message || '');
    window.open(`https://wa.me/${p}?text=${msg}`, '_blank');
  } else {
    window.open('https://wa.me/', '_blank');
  }
}

function openWAContact(name) {
  const contact = state.contacts.find(c => c.name.toLowerCase().includes(name.toLowerCase()));
  if (contact) {
    openWA(contact.phone, '');
  } else {
    toast('Contacto no encontrado');
    window.open('https://wa.me/', '_blank');
  }
}

function openYT() {
  window.open('https://youtube.com', '_blank');
}

// ============================================================
// NV AI
// ============================================================
async function sendNV() {
  const input = document.getElementById('nv-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  // Primero intentar con motor NV local
  const result = await nvProcesar(text);
  if (result && result.action !== 'ia' && result.action !== 'unknown' && result.msg) {
    appendNVMsg(text, 'user');
    appendNVMsg(result.msg, 'nv');
    await nvHandleResult(result, text);
    return;
  }
  // Fallback a IA
  appendNVMsg(text, 'user');
  const thinking = appendNVMsg('Pensando...', 'nv');
  try {
    const resp = await callNVAI(text);
    thinking.textContent = resp;
    speak(resp.slice(0, 150));
  } catch(e) {
    thinking.textContent = 'Sin conexión a NV.';
  }
}

function appendNVMsg(text, role) {
  const chat = document.getElementById('nv-chat');
  const msg = document.createElement('div');
  msg.className = `nv-msg ${role === 'user' ? 'user' : ''}`;
  const bubble = document.createElement('div');
  bubble.className = 'nv-bubble';
  bubble.textContent = text;
  msg.appendChild(bubble);
  chat.appendChild(msg);
  chat.parentElement.scrollTop = chat.parentElement.scrollHeight;
  return bubble;
}

// ============================================================
// SEARCH
// ============================================================
function doSearch(q) {
  const cont = document.getElementById('search-results');
  if (!q || q.length < 2) { cont.innerHTML = ''; return; }
  const ql = q.toLowerCase();
  const results = [];
  function searchIn(f, prefix) {
    (f.entries || []).forEach(e => {
      if (e.text.toLowerCase().includes(ql)) results.push({ folder: prefix + f.name, icon: f.icon, text: e.text, date: e.date });
    });
    if (f.sub) f.sub.forEach(s => searchIn(s, f.name + ' / '));
  }
  state.folders.forEach(f => searchIn(f, ''));

  if (results.length === 0) {
    cont.innerHTML = '<div class="empty-state"><div>Sin resultados para "' + q + '"</div></div>';
    return;
  }
  cont.innerHTML = results.map(r => `
    <div class="entry-card">
      <div style="flex:1">
        <div style="font-size:0.75em;color:var(--text2);margin-bottom:4px;">${r.icon} ${r.folder}</div>
        <div class="entry-text">${r.text}</div>
        <div class="entry-date">${r.date ? new Date(r.date).toLocaleString('es-AR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : ''}</div>
      </div>
    </div>
  `).join('');
}

// ============================================================
// CONFIG
// ============================================================
function setTheme(t, el) {
  state.theme = t;
  document.body.className = 't-' + t;
  document.querySelectorAll('.theme-pill').forEach(p => p.classList.remove('active'));
  if (el) el.classList.add('active');
  saveState();
}

function setFontSize(v) {
  state.fontSize = parseInt(v);
  document.documentElement.style.setProperty('--font-size', v + 'px');
  document.getElementById('font-label').textContent = v + 'px';
  saveState();
}

function setLayout(l, el) {
  state.layout = l;
  document.querySelectorAll('.layout-pill').forEach(p => p.classList.remove('active'));
  if (el) el.classList.add('active');
  renderFolders();
  saveState();
}

function renderConfigFolders() {
  const cont = document.getElementById('folder-config-list');
  cont.innerHTML = '';
  state.folders.forEach((f, idx) => {
    const row = document.createElement('div');
    row.className = 'config-row';
    row.style.marginBottom = '6px';
    row.innerHTML = `
      <span style="font-size:1.4em;">${f.icon}</span>
      <div class="config-row-label">${f.name}</div>
      <button onclick="toggleFolderHide(${idx})" style="background:${f.hidden?'var(--bg3)':'var(--accent2)'};color:${f.hidden?'var(--text2)':'var(--green)'};border:none;border-radius:8px;padding:6px 10px;cursor:pointer;font-size:0.8em;">${f.hidden ? 'Mostrar' : 'Ocultar'}</button>
    `;
    cont.appendChild(row);
  });
}

function toggleFolderHide(idx) {
  state.folders[idx].hidden = !state.folders[idx].hidden;
  saveState();
  renderFolders();
  renderConfigFolders();
}

// ============================================================
// CONTACTS
// ============================================================
function renderContacts() {
  const cont = document.getElementById('contacts-list');
  cont.innerHTML = '';
  state.contacts.forEach((c, i) => {
    const el = document.createElement('div');
    el.className = 'contact-item';
    el.innerHTML = `
      <div class="contact-avatar">👤</div>
      <div class="contact-info">
        <div class="contact-name">${c.name}</div>
        <div class="contact-phone">${c.phone}</div>
      </div>
      <div class="contact-actions">
        <button class="contact-btn call" onclick="callContact('${c.phone}')" title="Llamar">📞</button>
        <button class="contact-btn whatsapp" onclick="openWA('${c.phone}','Hola ${c.name}!')" title="WhatsApp">💬</button>
        <button class="contact-btn" onclick="deleteContact(${i})" title="Borrar">🗑️</button>
      </div>
    `;
    cont.appendChild(el);
  });
}

function callContact(phone) {
  window.open('tel:' + phone);
}

function openAddContactModal() {
  document.getElementById('new-contact-name').value = '';
  document.getElementById('new-contact-phone').value = '';
  openModal('add-contact-modal');
}

function addContact() {
  const name = document.getElementById('new-contact-name').value.trim();
  const phone = document.getElementById('new-contact-phone').value.trim().replace(/\s/g, '');
  if (!name || !phone) { toast('Completá nombre y teléfono'); return; }
  state.contacts.push({ name, phone });
  saveState();
  renderContacts();
  closeModal('add-contact-modal');
  toast('✅ Contacto guardado');
}

function deleteContact(idx) {
  if (!confirm('¿Eliminar este contacto?')) return;
  state.contacts.splice(idx, 1);
  saveState();
  renderContacts();
}

// ============================================================
// REMINDERS & NOTIFICATIONS (FIX #12: background notifications)
// ============================================================
function requestNotifPermission() {
  if (!('Notification' in window)) { toast('Notificaciones no disponibles'); return; }
  Notification.requestPermission().then(perm => {
    if (perm === 'granted') {
      toast('🔔 Notificaciones activadas');
      document.getElementById('notif-banner').classList.remove('show');
      // Register service worker for background notifications
      registerSW();
    } else {
      toast('Permiso denegado — las notificaciones no funcionarán en segundo plano');
    }
  });
}

function registerSW() {
  if ('serviceWorker' in navigator) {
    const swCode = `
self.addEventListener('message', e => {
  if (e.data && e.data.type === 'SCHEDULE_NOTIF') {
    const { title, body, delay } = e.data;
    setTimeout(() => {
      self.registration.showNotification(title, {
        body, icon: '/icon-192.png', badge: '/icon-192.png',
        vibrate: [200, 100, 200],
        tag: 'nv-reminder-' + Date.now()
      });
    }, delay);
  }
});
self.addEventListener('notificationclick', e => { e.notification.close(); });
`;
    const blob = new Blob([swCode], { type: 'application/javascript' });
    const url = URL.createObjectURL(blob);
    navigator.serviceWorker.register(url).then(reg => {
      window._swReg = reg;
      toast('Service worker activo');
    }).catch(e => {
      // SW may not work on some hosts, fallback to setTimeout
    });
  }
}

function openReminderModal() {
  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];
  const timeStr = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
  document.getElementById('reminder-date').value = dateStr;
  document.getElementById('reminder-time').value = timeStr;
  document.getElementById('reminder-text').value = '';
  document.getElementById('reminder-modal').classList.add('open');
}

function closeReminderModal() {
  document.getElementById('reminder-modal').classList.remove('open');
}

function saveReminder() {
  const text = document.getElementById('reminder-text').value.trim();
  const date = document.getElementById('reminder-date').value;
  const time = document.getElementById('reminder-time').value;
  if (!text || !date || !time) { toast('Completá todos los campos'); return; }

  const triggerAt = new Date(`${date}T${time}`);
  const now = new Date();
  const delay = triggerAt - now;

  if (delay < 0) { toast('La fecha/hora ya pasó'); return; }

  const reminder = { text, triggerAt: triggerAt.toISOString(), id: Date.now() };
  state.reminders.push(reminder);
  saveState();

  // Schedule notification
  scheduleNotification(text, delay, reminder.id);

  // Also save in current folder if open
  if (state.currentFolder) {
    const f = findFolder(state.currentFolder);
    if (f) {
      f.entries.push({ text: `⏰ ${text}`, date: now.toISOString(), reminder: triggerAt.toISOString() });
      saveState();
      renderFolderEntries(f);
    }
  }

  closeReminderModal();
  toast(`⏰ Recordatorio programado para ${triggerAt.toLocaleString('es-AR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}`);
}

function scheduleNotification(text, delayMs, id) {
  if ('Notification' in window && Notification.permission === 'granted') {
    // Try SW for true background
    if (window._swReg) {
      window._swReg.active?.postMessage({ type: 'SCHEDULE_NOTIF', title: '⏰ Nueva Vida', body: text, delay: delayMs });
    }
    // Fallback: setTimeout (works while app is open)
    setTimeout(() => {
      if (Notification.permission === 'granted') {
        new Notification('⏰ Nueva Vida', { body: text, icon: '⏰', vibrate: [200, 100, 200] });
      }
      // Also show toast
      toast(`⏰ ${text}`);
      // Remove from list
      state.reminders = state.reminders.filter(r => r.id !== id);
      saveState();
    }, delayMs);
  } else {
    // setTimeout-only fallback
    setTimeout(() => {
      toast(`⏰ RECORDATORIO: ${text}`);
      alert(`⏰ RECORDATORIO:\n${text}`);
      state.reminders = state.reminders.filter(r => r.id !== id);
      saveState();
    }, delayMs);
  }
}

function restoreReminders() {
  const now = new Date();
  state.reminders.forEach(r => {
    const triggerAt = new Date(r.triggerAt);
    const delay = triggerAt - now;
    if (delay > 0) scheduleNotification(r.text, delay, r.id);
  });
}

// ============================================================
// ADD FOLDER
// ============================================================
let selectedColor = 'blue';

function selectColor(color, el) {
  selectedColor = color;
  document.querySelectorAll('#color-picker div').forEach(d => d.style.borderColor = 'transparent');
  el.style.borderColor = '#fff';
}

function openAddFolderModal() {
  selectedColor = 'blue';
  openModal('add-folder-modal');
}

function addFolder() {
  const icon = document.getElementById('new-folder-icon').value.trim() || '📁';
  const name = document.getElementById('new-folder-name').value.trim();
  if (!name) { toast('Escribí un nombre'); return; }
  const id = 'f_' + Date.now();
  state.folders.push({ id, icon, name, color: selectedColor, entries: [] });
  saveState();
  renderFolders();
  renderConfigFolders();
  closeModal('add-folder-modal');
  toast('📁 Carpeta creada');
}

// ============================================================
// BACKUP
// ============================================================
function exportBackup() {
  const data = JSON.stringify(state, null, 2);
  const blob = new Blob([data], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'nueva-vida-backup-' + new Date().toISOString().split('T')[0] + '.json';
  a.click();
}

function importBackup(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      const existing = state.folders;
      // Smart import: ask merge or replace
      if (confirm('¿Reemplazar todos los datos? Tocá "Cancelar" para solo agregar lo que falta.')) {
        state = { ...state, ...data };
      } else {
        // Merge: add missing entries
        if (data.folders) {
          data.folders.forEach(importedF => {
            const existingF = state.folders.find(f => f.id === importedF.id);
            if (existingF) {
              const existingTexts = new Set(existingF.entries.map(e => e.text));
              importedF.entries.forEach(e => { if (!existingTexts.has(e.text)) existingF.entries.push(e); });
            } else {
              state.folders.push(importedF);
            }
          });
        }
        if (data.contacts) {
          const existingPhones = new Set(state.contacts.map(c => c.phone));
          data.contacts.forEach(c => { if (!existingPhones.has(c.phone)) state.contacts.push(c); });
        }
      }
      saveState();
      init();
      toast('✅ Datos importados');
    } catch(e) { toast('Error al importar — archivo inválido'); }
  };
  reader.readAsText(file);
}

function backupWhatsApp() {
  const lines = [];
  state.folders.forEach(f => {
    if (f.entries.length > 0) {
      lines.push(`📁 *${f.name}*`);
      f.entries.forEach(e => lines.push(`• ${e.text}`));
    }
  });
  const msg = '🗂️ *Backup Nueva Vida*\n' + new Date().toLocaleString('es-AR') + '\n\n' + lines.join('\n');
  window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank');
}

function clearAll() {
  if (!confirm('¿Borrar TODOS los datos? Esta acción no se puede deshacer.')) return;
  if (!confirm('¿Seguro? Se van a borrar todas tus carpetas y entradas.')) return;
  state.folders = JSON.parse(JSON.stringify(DEFAULT_FOLDERS));
  state.contacts = [];
  state.reminders = [];
  saveState();
  init();
  toast('Datos borrados');
}

// ============================================================
// MODALS & UTILS
// ============================================================
function openModal(id) {
  document.getElementById(id).classList.add('open');
}

function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
}

// ============================================================
// APPLY SAVED SETTINGS
// ============================================================
function applySettings() {
  document.body.className = 't-' + (state.theme || 'dark');
  const fs = state.fontSize || 17;
  document.documentElement.style.setProperty('--font-size', fs + 'px');
  document.getElementById('font-slider').value = fs;
  document.getElementById('font-label').textContent = fs + 'px';

  // Theme pills
  document.querySelectorAll('.theme-pill').forEach(p => {
    p.classList.remove('active');
    if (p.getAttribute('onclick') && p.getAttribute('onclick').includes(`'${state.theme}'`)) p.classList.add('active');
  });

  // Layout pills
  document.querySelectorAll('.layout-pill').forEach(p => {
    p.classList.remove('active');
    if (p.getAttribute('onclick') && p.getAttribute('onclick').includes(`'${state.layout}'`)) p.classList.add('active');
  });
}

// ============================================================
// NOTIFICATION BANNER CHECK
// ============================================================
function checkNotifPermission() {
  if (!('Notification' in window)) return;
  const banner = document.getElementById('notif-banner');
  if (Notification.permission === 'default') {
    banner.classList.add('show');
  } else if (Notification.permission === 'granted') {
    banner.classList.remove('show');
    registerSW(); // registrar SW si ya tiene permiso
  }
}

// ============================================================
// INIT
// ============================================================
function init() {
  loadState();
  applySettings();
  renderFolders();
  renderConfigFolders();
  renderContacts();
  updateWeather();
  restoreReminders();
  checkNotifPermission();
  renderConductorQuick();
  // Refresh weather every 30 min
  setInterval(updateWeather, 30 * 60 * 1000);
  // Re-check sun alert every 15 min
  setInterval(() => {
    const hour = new Date().getHours();
    const sunAlert = document.getElementById('sun-alert');
    if (hour >= 10 && hour < 16) sunAlert.classList.add('visible');
    else sunAlert.classList.remove('visible');
  }, 15 * 60 * 1000);
}

window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
